# Local Development / Testing Configuration
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-for-production-testing-2027
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=portal.t4f-global.org,localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.t4f-global.org,http://portal.t4f-global.org,http://localhost:8080,http://127.0.0.1:8080
WEB_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# Database (PostgreSQL 17 for Docker, or set DB_ENGINE=sqlite for local SQLite)
DB_ENGINE=postgresql
POSTGRES_DB=t4f_global
POSTGRES_USER=t4f_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PORT_BINDING=5432

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_PORT_BINDING=16379

# Initial Super Admin
INITIAL_ADMIN_EMAIL=admin@t4f-global.org
INITIAL_ADMIN_PASSWORD=T4f#2027
INITIAL_ADMIN_NAME=Tech4Future-Global Super Administrator

# Security
COOKIE_SECURE=false

# SMTP Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tech4Future-Global <no-reply@t4f-global.org>
