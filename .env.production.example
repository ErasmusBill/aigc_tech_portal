# Production Environment Variables for Tech4Future-Global Management System V13

# Django Core & Security
# Generate a strong key with: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=generate-and-set-a-strong-random-secret-key-here
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=t4f-global.org,api.t4f-global.org,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://t4f-global.org,https://api.t4f-global.org

# Database (PostgreSQL 17)
DB_ENGINE=postgresql
POSTGRES_DB=t4f_global
POSTGRES_USER=t4f_app
POSTGRES_PASSWORD=generate-a-strong-database-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=600

# Redis Cache
REDIS_URL=redis://redis:6379/0

# Platform Initial Admin Setup
INITIAL_ADMIN_EMAIL=admin@t4f-global.org
INITIAL_ADMIN_PASSWORD=T4FGlobal@2026!
INITIAL_ADMIN_NAME=Tech4Future-Global Super Administrator

# Security Headers & Cookies
COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# Server Concurrency
WEB_WORKERS=4
PORT=8000

# Email Delivery (SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key-here
SMTP_TLS=true
SMTP_FROM=Tech4Future-Global <no-reply@t4f-global.org>
